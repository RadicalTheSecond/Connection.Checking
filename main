pp_fframe = tk.Frame(pp_lframe, bg="white")
pp_fframe.place(x=20, y=150, width=560, height=720)

pp_fdata = {}
#флаг, опис., обязательно ли (и нужно ли поле), по умолчанию
pp_flist = [("-n", "Число запросов", True, "100"), ("-h", "Макс. число прыжков", True, "30"), 
("-g", "Не резолвить имена (как -n у ping)", False, None), ("-p", "Пауза между пингами (мс)", True, "250"),
("-q", "Число запросов на прыжок", True, "100"), ("-w", "Таймаут (мс)", True, "1000"),
("-4", "IPv4", False, None), ("-6", "IPv6", False, None)]

def pp_on_checkbox_toggle(var, entry_widget):
    if entry_widget:
        if var.get():
            entry_widget.config(state="normal", bg="white")
        else:
            entry_widget.config(state="disabled", bg="gray")

row = 0
for flag, desc, necessary, def_val in pp_flist:
    var = tk.BooleanVar(value=False)
    cbox = tk.Checkbutton(pp_fframe, text=f"{flag} ({desc})", variable=var, bg="white", anchor="w", font=("Arial", 14))
    cbox.grid(row=row, column=0, sticky="w", pady=2)
    entry_widget = None
    if necessary:
        entry_widget = tk.Entry(pp_fframe, width=15, highlightbackground="gray", highlightthickness=1)
        entry_widget.insert(0, def_val)
        entry_widget.config(state="disabled", bg="gray")
        entry_widget.grid(row=row, column=1, sticky="w", padx=5)
        cbox.config(command=lambda v=var, e=entry_widget: pp_on_checkbox_toggle(v, e))

    pp_fdata[flag] = {"var": var, "entry": entry_widget}
    row += 1

def pathping():
    site = pp_entry.get().strip()

    pp_text.delete("1.0", END)
    pp_text.insert("1.0", f"Pathping {site} ...\n\n")

    args = []
    for flag, desc, necessary, def_val in pp_flist:
        data = pp_fdata[flag]
        if data["var"].get():
            args.append(flag)
            if necessary and data["entry"]:
                val = data["entry"].get().strip()
                if val:
                    args.append(val)

    with open("pathping.txt", "w", encoding="cp866") as f:
        cmd = f'pathping {site}'
        for arg in args:
            cmd += f' {arg}'
        a = subprocess.Popen(cmd, stdout=subprocess.PIPE, text=True, encoding="cp866")
        for l in a.stdout:
            f.write(l)
            f.flush()
            pp_text.insert(END, l)
            pp_text.see(END)
            window.update()

bpathping = tk.Button(pp_lframe, text="Запустить pathping", command=pathping)
bpathping.place(x=20, y=110, width=350, height=30)

