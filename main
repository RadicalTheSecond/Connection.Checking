arp_notebook.place(x=680, y=50, width=690, height=880)

arp_tab_raw = ttk.Frame(arp_notebook)
arp_tab_table = ttk.Frame(arp_notebook)
arp_tab_graph = ttk.Frame(arp_notebook)

arp_notebook.add(arp_tab_raw, text="Весь вывод")
arp_notebook.add(arp_tab_table, text="Таблица")
arp_notebook.add(arp_tab_graph, text="Граф")

arp_text = tk.Text(arp_tab_raw, bg="white", highlightbackground="gray", highlightthickness=1, font=("Consolas", 10))
arp_text.pack(fill=BOTH, expand=True)

arp_cols = ("ip", "mac", "type", "iface")
arp_tree = ttk.Treeview(arp_tab_table, columns=arp_cols, show="headings")
arp_tree.heading("ip", text="IP-адрес")
arp_tree.heading("mac", text="MAC-адрес")
arp_tree.heading("type", text="Тип")
arp_tree.heading("iface", text="Интерфейс")
arp_tree.column("ip", width=120, anchor="center")
arp_tree.column("mac", width=150, anchor="center")
arp_tree.column("type", width=110, anchor="center")
arp_tree.column("iface", width=150, anchor="center")

arp_tree_scroll = ttk.Scrollbar(arp_tab_table, orient="vertical", command=arp_tree.yview)
arp_tree.configure(yscrollcommand=arp_tree_scroll.set)
arp_tree.pack(side=LEFT, fill=BOTH, expand=True)
arp_tree_scroll.pack(side=RIGHT, fill=Y)

arp_graph_bar = tk.Frame(arp_tab_graph, bg="white", pady=8, padx=10)
arp_graph_bar.pack(fill=X)

arp_legend = tk.Label(arp_graph_bar, text="Центр — интерфейс ПК | Узлы — устройства в сети (красные — статические, зелёные — динамические)",
                      bg="white", font=("Arial", 10), fg="gray")
arp_legend.pack(side=LEFT)

arp_canvas = tk.Canvas(arp_tab_graph, bg="white", highlightbackground="gray", highlightthickness=1)
arp_canvas.pack(fill=BOTH, expand=True, padx=5, pady=5)

arp_fframe = tk.Frame(arp_lframe, bg="white")
arp_fframe.place(x=20, y=100, width=560, height=400)

arp_fdata = {}
arp_flist = [
    ("-a", "Показать все записи", 0, None),
    ("-g", "То же, что и -a (пусть будет)", 0, None),
    ("-v", "Подробный вывод", 0, None),
    ("-N", "Интерфейс (IP)", 1, ""),
    ("-d", "Удалить запись (IP / *)", 1, ""),
    ("-s", "Добавить стат. (IP +MAC)", 2, ("", "")),
]

def arp_on_checkbox_toggle(var, entries):
    for e in entries:
        if e:
            if var.get():
                e.config(state="normal", bg="white")
            else:
                e.config(state="disabled", bg="gray")

row = 0
for flag, desc, fields_count, def_val in arp_flist:
    var = tk.BooleanVar(value=False)
    
    cbox = tk.Checkbutton(arp_fframe, text=f"{flag} ({desc})", variable=var, bg="white", anchor="w", font=("Arial", 14))
    cbox.grid(row=row, column=0, columnspan=3, sticky="w", pady=2)
    
    entries = []
    if fields_count >= 1:
        e1 = tk.Entry(arp_fframe, width=20, highlightbackground="gray", highlightthickness=1)
        e1.insert(0, def_val[0] if isinstance(def_val, tuple) else def_val)
        e1.config(state="disabled", bg="gray")
        e1.grid(row=row, column=3, sticky="w", padx=5)
        entries.append(e1)
        
    if fields_count == 2:
        e2 = tk.Entry(arp_fframe, width=20, highlightbackground="gray", highlightthickness=1)
        e2.insert(0, def_val[1])
        e2.config(state="disabled", bg="gray")
        e2.grid(row=row, column=4, sticky="w", padx=5)
        entries.append(e2)
        
    if entries:
        cbox.config(command=lambda v=var, es=entries: arp_on_checkbox_toggle(v, es))

    arp_fdata[flag] = {"var": var, "entries": entries}
    row += 1

def parse_arp_output(raw_text):
    devices = []
    current_iface = "Неизвестно"
    current_iface_ip = "—"
    
    for line in raw_text.splitlines():
        s = line.strip()
        if not s:
            continue
            
        m_iface = re.search(r"Интерфейс:\s*([\d\.]+)", line, re.IGNORECASE)
        if m_iface:
            current_iface_ip = m_iface.group(1)
            current_iface = f"ПК ({current_iface_ip})"
            continue
            
        if "Адрес IP" in line or "Адрес физического" in line or "Тип" in line:
            continue
            
        # "192.168.1.1          00-11-22-33-44-55     динамический"
        m_dev = re.match(r"([\d\.]+)\s+([0-9a-fA-F\-]{17})\s+(.+)", s)
        if m_dev:
            devices.append({
                "ip": m_dev.group(1).strip(),
                "mac": m_dev.group(2).strip(),
                "type": m_dev.group(3).strip(),
                "iface": current_iface,
                "iface_ip": current_iface_ip
            })
            
    return devices

def update_arp_table(devices):
    for item in arp_tree.get_children():
        arp_tree.delete(item)
    for d in devices:
        arp_tree.insert("", END, values=(d["ip"], d["mac"], d["type"], d["iface"]))

def draw_arp_graph(devices):
    arp_canvas.delete("all")
    if not devices:
        arp_canvas.create_text(340, 300, text="Нет данных ARP для построения графа.\nЗапустите arp.",
                               fill="#666666", font=("Arial", 13), justify="center")
        return

    arp_canvas.update_idletasks()
    W = max(arp_canvas.winfo_width(), 660)
    H = max(arp_canvas.winfo_height(), 780)

    groups = {}
    for d in devices:
        groups.setdefault(d["iface_ip"], []).append(d)

    num_ifaces = len(groups)
    if num_ifaces == 0:
        return

    cell_height = H / num_ifaces

    for idx, (iface_ip, nodes) in enumerate(groups.items()):
        cx = W / 2
        cy = cell_height * idx + cell_height / 2
        
        if idx > 0:
            arp_canvas.create_line(20, cell_height * idx, W - 20, cell_height * idx, fill="#e0e0e0", dash=(4, 4))

        r_center = 20
        arp_canvas.create_oval(cx - r_center, cy - r_center, cx + r_center, cy + r_center,
                               fill="#2196F3", outline="black", width=2)
        arp_canvas.create_text(cx, cy, text="ПК", fill="white", font=("Arial", 9, "bold"))
        arp_canvas.create_text(cx, cy + r_center + 8, text=iface_ip, font=("Arial", 9, "bold"), anchor="n")

        n = len(nodes)
        if n == 0:
            continue

        max_radius_y = (cell_height / 2) - 50
        max_radius_x = (W / 2) - 110 
        max_radius = min(max_radius_x, max_radius_y)
        if max_radius < 60: 
            max_radius = 60

        for i, dev in enumerate(nodes):
            angle = 2 * math.pi * i / n
            x = cx + max_radius * math.cos(angle)
            y = cy + max_radius * math.sin(angle)
            fill = "#F44336" if "статич" in dev["type"].lower() else "#4CAF50"
            arp_canvas.create_line(cx, cy, x, y, fill="gray", width=2)
            r_node = 14
            arp_canvas.create_oval(x - r_node, y - r_node, x + r_node, y + r_node, fill=fill, outline="black", width=1)
            arp_canvas.create_text(x, y + r_node + 5, text=dev["ip"], font=("Arial", 8), anchor="n")

def arp():
    arp_text.delete("1.0", END)
    for item in arp_tree.get_children():
        arp_tree.delete(item)
    arp_canvas.delete("all")
    arp_text.insert("1.0", "Запрос ARP-таблицы...\n\n")

    args = []
    is_modification = False

    for flag, desc, fields_count, def_val in arp_flist:
        data = arp_fdata[flag]
        if data["var"].get():
            if flag in ("-a", "-g", "-v"):
                args.append(flag)
            elif flag == "-N":
                val = data["entries"][0].get().strip()
                if val:
                    if "-a" not in args and "-g" not in args:
                        args.append("-a")
                    args.extend([flag, val])
            elif flag == "-d":
                val = data["entries"][0].get().strip()
                if val:
                    args.extend([flag, val])
                    is_modification = True
            elif flag == "-s":
                ip = data["entries"][0].get().strip()
                mac = data["entries"][1].get().strip()
                if ip and mac:
                    mac = mac.replace(":", "-")
                    args.extend([flag, ip, mac])
                    is_modification = True

    if not args:
        arp_text.insert(END, "Выберите хотя бы один флаг (например, -a).\n")
        return

    collected = []
    with open("arp.txt", "w", encoding="cp866") as f:
        cmd = f"arp {' '.join(args)}"
        a = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, encoding="cp866")
        stdout, stderr = a.communicate()
        
        if stderr:
            collected.append("=== ОШИБКА ===\n")
            collected.append(stderr)
            arp_text.insert(END, stderr)
        else:
            collected.append(stdout)
            arp_text.insert(END, stdout)
            f.write(stdout)

    output = "".join(collected)
    
    if not is_modification:
        devices = parse_arp_output(output)
        update_arp_table(devices)
        draw_arp_graph(devices)
    else:
        arp_text.insert(END, "\n\nКэш ARP успешно изменён. Запустите с флагом -a для просмотра актуальной таблицы.\n")

barp = tk.Button(arp_lframe, text="Запустить arp", command=arp)
barp.place(x=20, y=60, width=500, height=30)

if os.path.exists("arp.txt"):
    with open("arp.txt", "r", encoding="cp866", errors="replace") as f:
        old_text = f.read()
    if old_text.strip() and "ОШИБКА" not in old_text:
        arp_text.insert("1.0", old_text)
        devices = parse_arp_output(old_text)
        update_arp_table(devices)
        draw_arp_graph(devices)

window.mainloop()