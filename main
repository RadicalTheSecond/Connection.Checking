pp_hops_data = []
pp_node_positions = [] 
pp_anim_job = None
pp_packet_item = None

def parse_loss_percent(loss_str):
    if not loss_str: return None
    m_pct = re.search(r"(\d+(?:[.,]\d+)?)\s*%", loss_str)
    if m_pct: return float(m_pct.group(1).replace(",", "."))
    m_frac = re.search(r"(\d+)\s*/\s*(\d+)", loss_str)
    if m_frac:
        lost, sent = int(m_frac.group(1)), int(m_frac.group(2))
        if sent > 0: return (lost / sent) * 100.0
    return None

def parse_pathping_output(raw_text):
    hops = {}
    hop_order = []
    
    stat_full_re = re.compile(r"(\d+)\s*/\s*(\d+)\s*=\s*(\d+)%")
    
    for line in raw_text.splitlines():
        s = line.strip()
        if not s: continue

        m_hop = re.match(r"^(\d+)\s+(.+)$", s)
        if not m_hop: continue
        
        hop_num = int(m_hop.group(1))
        rest = m_hop.group(2).strip()
        
        if re.search(r"(\d+)\s*[мm][сs]", rest, re.IGNORECASE):
            time_match = re.search(r"(\d+\s*[мm][сs])", rest, re.IGNORECASE)
            time_str = time_match.group(1) if time_match else "—"
            
            if hop_num not in hops:
                hops[hop_num] = {"hop": str(hop_num), "address": "—", "time": time_str,
                                 "loss_to_node": "—", "loss_at_node": "—", "has_node_loss": False}
                hop_order.append(hop_num)
            else:
                hops[hop_num]["time"] = time_str
            continue
            
        stats = stat_full_re.findall(rest)
        if stats:
            to_node_raw = f"{stats[0][0]}/{stats[0][1]} = {stats[0][2]}%"
            if len(stats) > 1:
                at_node_raw = f"{stats[1][0]}/{stats[1][1]} = {stats[1][2]}%"
            else:
                at_node_raw = "0/ 0 = 0%"
            
            to_pct = parse_loss_percent(to_node_raw)
            at_pct = parse_loss_percent(at_node_raw)
            
            loss_to_str = f"{to_pct:g}% ({to_node_raw.split('=')[0].strip()})" if to_pct is not None else to_node_raw
            loss_at_str = f"{at_pct:g}% ({at_node_raw.split('=')[0].strip()})" if at_pct is not None else at_node_raw
            
            addr_match = re.search(r"%\s*\|?\s*(.+?)$", rest)
            addr_str = addr_match.group(1).strip() if addr_match else "—"
            
            if hop_num not in hops:
                hops[hop_num] = {"hop": str(hop_num), "address": addr_str, "time": "—",
                                 "loss_to_node": loss_to_str, "loss_at_node": loss_at_str,
                                 "has_node_loss": bool(at_pct > 0)}
                hop_order.append(hop_num)
            else:
                if addr_str != "—" and hops[hop_num]["address"] == "—":
                    hops[hop_num]["address"] = addr_str
                hops[hop_num]["loss_to_node"] = loss_to_str
                hops[hop_num]["loss_at_node"] = loss_at_str
                hops[hop_num]["has_node_loss"] = bool(at_pct > 0)
            continue

        if rest and not hops.get(hop_num, {}).get("address"):
            if hop_num not in hops:
                hops[hop_num] = {"hop": str(hop_num), "address": rest, "time": "—",
                                 "loss_to_node": "—", "loss_at_node": "—", "has_node_loss": False}
                hop_order.append(hop_num)
            else:
                hops[hop_num]["address"] = rest

    return [hops[h] for h in hop_order]

def update_pathping_table(hops_list):
    for row_id in pp_tree.get_children(): pp_tree.delete(row_id)
    for item in hops_list:
        pp_tree.insert("", END, values=(item["hop"], item["address"], item["time"], item["loss_to_node"], item["loss_at_node"]))

def stop_packet_animation():
    global pp_anim_job, pp_packet_item
    if pp_anim_job is not None:
        window.after_cancel(pp_anim_job)
        pp_anim_job = None
    if pp_packet_item is not None:
        pp_canvas.delete(pp_packet_item)
        pp_packet_item = None

def draw_pathping_graph(hops_list):
    global pp_node_positions
    stop_packet_animation()
    pp_canvas.delete("all")
    pp_node_positions = []

    if not hops_list:
        pp_canvas.create_text(340, 300, text="Нет данных о прыжках для построения графа.\nЗапустите pathping.", 
                              fill="#666666", font=("Arial", 13), justify="center")
        return

    pp_canvas.update_idletasks()
    W = max(pp_canvas.winfo_width(), 660)
    
    n = len(hops_list)
    r = 18
    cx = W / 2  
    y_start = 50
    y_step = 90  

    total_height = y_start + n * y_step + 50
    pp_canvas.configure(scrollregion=(0, 0, W, total_height))

    for i in range(n - 1):
        y1 = y_start + i * y_step + r
        y2 = y_start + (i + 1) * y_step - r
        color = "red" if hops_list[i+1].get("has_node_loss") else "gray"
        width = 3 if color == "red" else 2
        pp_canvas.create_line(cx, y1, cx, y2, fill=color, width=width, arrow="last")

    for i, item in enumerate(hops_list):
        y = y_start + i * y_step
        if i == 0: fill = "#4CAF50"
        elif i == n - 1: fill = "#2196F3"
        elif item.get("has_node_loss"): fill = "#F44336"
        else: fill = "#E0E0E0"

        pp_canvas.create_oval(cx - r, y - r, cx + r, y + r, fill=fill, outline="black", width=2, tags=f"node{i}")
        pp_canvas.create_text(cx, y, text=str(item["hop"]), font=("Arial", 10, "bold"), tags=f"node{i}")
    
        label = item["address"]
        if len(label) > 25: label = label[:23] + "…"
        pp_canvas.create_text(cx + r + 15, y, text=label, font=("Arial", 9), anchor="w", tags=f"node{i}")

        pp_node_positions.append((i, cx, y, fill))

def animate_packet():
    global pp_anim_job, pp_packet_item
    stop_packet_animation()
    if not pp_node_positions: return

    pp_notebook.select(pp_tab_graph)
    pp_canvas.update_idletasks()

    steps_per_segment = 20
    delay_ms = 25
    path_coords = []

    for i in range(len(pp_node_positions) - 1):
        _, x1, y1, _ = pp_node_positions[i]
        _, x2, y2, _ = pp_node_positions[i + 1]
        for s in range(steps_per_segment):
            t = s / steps_per_segment
            path_coords.append((x1 + (x2 - x1) * t, y1 + (y2 - y1) * t))

    _, last_x, last_y, _ = pp_node_positions[-1]
    path_coords.append((last_x, last_y))

    r = 8
    start_x, start_y = path_coords[0]
    pp_packet_item = pp_canvas.create_oval(start_x - r, start_y - r, start_x + r, start_y + r,
                                           fill="#FFC107", outline="black", width=1, tags="packet")

    def step(idx=0):
        global pp_anim_job, pp_packet_item
        if idx >= len(path_coords) or pp_packet_item is None:
            pp_anim_job = None
            return

        px, py = path_coords[idx]
        pp_canvas.coords(pp_packet_item, px - r, py - r, px + r, py + r)
        pp_anim_job = window.after(delay_ms, lambda: step(idx + 1))

    step(0)

b_animate_packet.config(command=animate_packet)

def refresh_pathping_views(raw_text):
    global pp_hops_data
    pp_hops_data = parse_pathping_output(raw_text)
    update_pathping_table(pp_hops_data)
    draw_pathping_graph(pp_hops_data)

def pathping():
    site = pp_entry.get().strip()
    stop_packet_animation()

    pp_text.delete("1.0", END)
    pp_text.insert("1.0", f"Pathping {site} ...\n\n")

    args = []
    for flag, desc, necessary, def_val in pp_flist:
        data = pp_fdata[flag]
        if data["var"].get():
            args.append(flag)
            if necessary and data["entry"]:
                val = data["entry"].get().strip()
                if val: args.append(val)

    collected_lines = [f"Pathping {site} ...\n\n"]
    with open("pathping.txt", "w", encoding="cp866") as f:
        cmd = f"pathping {site}"
        for arg in args: cmd += f" {arg}"
        a = subprocess.Popen(cmd, stdout=subprocess.PIPE, text=True, encoding="cp866")
        for l in a.stdout:
            f.write(l)
            f.flush()
            collected_lines.append(l)
            pp_text.insert(END, l)
            pp_text.see(END)
            window.update()

    refresh_pathping_views("".join(collected_lines))

bpathping = tk.Button(pp_lframe, text="Запустить pathping", command=pathping)
bpathping.place(x=20, y=110, width=500, height=30)

# Автозагрузка старого вывода при старте
if os.path.exists("pathping.txt"):
    with open("pathping.txt", "r", encoding="cp866", errors="replace") as existing_f:
        existing_text = existing_f.read()
    if existing_text.strip():
        pp_text.insert("1.0", existing_text)
        refresh_pathping_views(existing_text)

