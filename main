def on_checkbox_toggle(var, entry_widget):
    if entry_widget:
        if var.get():
            entry_widget.config(state="normal", bg="white")
        else:
            entry_widget.config(state="disabled", bg="gray")

row = 0
for flag, desc, necessary, def_val in flist:
    var = tk.BooleanVar(value=False)
    cbox = tk.Checkbutton(fframe, text=f"{flag} ({desc})", variable=var, bg="white", anchor="w", font=("Arial", 14))
    cbox.grid(row=row, column=0, sticky="w", pady=2)
    entry_widget = None
    if necessary:
        entry_widget = tk.Entry(fframe, width=25, highlightbackground="gray", highlightthickness=1)
        entry_widget.insert(0, def_val)
        entry_widget.config(state="disabled", bg="gray")
        entry_widget.grid(row=row, column=1, sticky="w", padx=5)
        cbox.config(command=lambda v=var, e=entry_widget: on_checkbox_toggle(v, e))
    
    fdata[flag] = {"var": var, "entry": entry_widget}
    row += 1

def ping():
    site = entry.get().strip()
    # if not site:
    #     pass
    #     text.delete("1.0", END)
    #     text.insert("1.0", "Введите адрес сайта.")
    #     return

    text.delete("1.0", END)
    text.insert("1.0", f"Ping {site} ...\n\n")

    args = []
    for flag, desc, necessary, def_val in flist:
        data = fdata[flag]
        if data["var"].get():
            args.append(flag)
            if necessary and data["entry"]:
                val = data["entry"].get().strip()
                if val:
                    args.append(val)

    with open("ping.txt", "w") as f:
        #у меня не получалось нормально сделать работу -j -k, поэтому только так
        cmd = f'ping {site}'
        for arg in args:
            cmd += f' {arg}'
        a = subprocess.Popen(cmd, stdout=subprocess.PIPE, text=True, encoding="cp866")
        for l in a.stdout:
            f.write(l)
            f.flush()
            text.insert(END, l)
            window.update()

bping = tk.Button(lframe, text="Запустить ping", command=ping)
bping.place(x=20, y=110, width=500, height=30)

